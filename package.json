{
  "name": "pocketbase-uml",
  "version": "0.9.0",
  "description": "A free, open-source web application that generates UML diagrams based on PocketBase databases",
  "keywords": [
    "pocketbase",
    "uml",
    "diagrams",
    "database",
    "model",
    "data",
    "schema",
    "visualization",
    "data model",
    "view"
  ],
  "files": [
    "app",
    "cli.cjs",
    "README.md",
    "LICENSE"
  ],
  "repository": "pocketbase-uml/pocketbase-uml.github.io",
  "homepage": "https://pocketbase-uml.github.io",
  "license": "MIT",
  "author": {
    "name": "Ionut-Cristian Florescu",
    "email": "ionut.florescu@gmail.com",
    "url": "https://github.com/icflorescu"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/icflorescu"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node cli.cjs",
    "test": "npm run test:unit && npm run test:integration",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:integration": "playwright test",
    "test:unit": "vitest run",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "bin": {
    "pocketbase-uml": "./cli.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tanstack/svelte-query": "^6.4.1",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "js-base64": "^3.9.6",
    "lodash.throttle": "^4.1.1",
    "nomnoml": "^1.7.0",
    "pocketbase": "^0.28.2",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sass": "^1.108.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "the-new-css-reset": "^1.11.3",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "dependencies": {
    "commander": "^15.1.0",
    "figlet": "^1.12.0",
    "serve-handler": "^6.1.8"
  },
  "engines": {
    "node": ">=22.17"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.5"
  }
}
